# Copy to .env for local development. Generate secrets with:
# openssl rand -base64 32
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0

DATABASE_URL=postgres://amrutam:amrutam@localhost:5432/amrutam
DATABASE_READ_URL=
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=5000
DB_IDLE_IN_TX_TIMEOUT_MS=10000

REDIS_URL=redis://localhost:6379

JWT_KEYS={"k1":"replace-with-a-base64-32-byte-secret"}
JWT_ACTIVE_KID=k1
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=14
MFA_TOKEN_TTL_SEC=300
MFA_ISSUER=Amrutam
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

ENC_KEYS={"1":"replace-with-a-base64-32-byte-secret"}
ENC_ACTIVE_VERSION=1
KMS_KEY_ID=

RL_GLOBAL_PER_MIN=120
RL_AUTH_PER_MIN=10
RL_BOOKING_PER_MIN=20

SLOT_HOLD_MINUTES=10
MIN_BOOKING_LEAD_MINUTES=15
CANCEL_FULL_REFUND_HOURS=24
IDEMPOTENCY_TTL_HOURS=24

PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-secret
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
METRICS_TOKEN=replace-with-a-metrics-token